# Where every form on the site sends its data.
# Create a form at https://formspree.io (or any service that accepts a JSON POST),
# then paste its URL here and set the same variable in Vercel.
VITE_FORM_ENDPOINT=

# Set to "true" to let forms show a success message without sending anything
# (useful for client demos before the endpoint exists). Never needed in local dev.
VITE_FORM_DEMO=

# Paystack public key for the certification registration payment step
# (pk_live_... or pk_test_...). Leave blank to simulate a successful payment
# instead of opening a real checkout — useful for client demos before a
# Paystack account and backend verification exist. See README "Payments".
VITE_PAYSTACK_PUBLIC_KEY=
