# Django API base URL. Start the backend locally at http://localhost:8000.
VITE_API_URL=http://localhost:8000/api

# Set to "true" only for a disconnected frontend demo.
VITE_FORM_DEMO=

# Paystack public key for the certification registration payment step
# (pk_live_... or pk_test_...). The backend verifies payments with its separate
# PAYSTACK_SECRET_KEY before accepting a certification registration.
VITE_PAYSTACK_PUBLIC_KEY=
